# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Where the ledger lives. Leave empty to keep it in a local file (.data/).
# Set it to share one ledger across server instances (needed on Vercel).
# Supabase: Connect -> "Transaction pooler" connection string (port 6543).
DATABASE_URL=

# Optional overrides
# SAAKH_MODEL=anthropic/claude-haiku-5.5          # agents (tool calling)
# SAAKH_ROUTER_MODEL=anthropic/claude-haiku-5.5   # Sutradhar's quick routing call
# SAAKH_AUDIO_MODEL=google/gemini-3.5-flash-lite  # voice fallback for browsers without speech recognition
# SAAKH_DATA_DIR=.data                            # where the lake file lives when DATABASE_URL is empty
# SAAKH_PUBLIC_URL=https://saakh.vercel.app       # sent to OpenRouter as the app's address
